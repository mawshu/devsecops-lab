# -*- mode: ruby -*-
# vi: set ft=ruby :

VM_IP = "192.168.56.10"
TRIVY_VERSION = "0.74.0"

Vagrant.configure("2") do |config|
  # Бокс Ubuntu 22.04 (jammy): Canonical не публикует Vagrant-боксы для 24.04
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_url = "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64-vagrant.box"
  config.vm.box_check_update = false
  config.vm.hostname = "devsecops-vm"
  config.vm.boot_timeout = 600

  # Host-only сеть: хост обращается к VM по фиксированному адресу
  config.vm.network "private_network", ip: VM_IP

  # Порт приложения доступен как localhost:8080, только для самого хоста
  config.vm.network "forwarded_port", guest: 8080, host: 8080, host_ip: "127.0.0.1"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "devsecops-vm"
    vb.memory = 1536
    vb.cpus = 1
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  # Код проекта доступен в VM: корень проекта = каталог выше Vagrantfile
  config.vm.synced_folder "..", "/home/vagrant/devsecops-lab"

  # --- Шаг 0: DNS (устойчивое разрешение имён в NAT-сети VirtualBox) ---
  config.vm.provision "shell", name: "dns", inline: <<-SHELL
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p /etc/systemd/resolved.conf.d
    { echo "[Resolve]"; echo "DNS=8.8.8.8 1.1.1.1"; echo "FallbackDNS=9.9.9.9"; } > /tmp/lab-dns.conf
    if ! cmp -s /tmp/lab-dns.conf /etc/systemd/resolved.conf.d/lab.conf; then
      install -m 0644 /tmp/lab-dns.conf /etc/systemd/resolved.conf.d/lab.conf
      systemctl restart systemd-resolved
    fi
  SHELL

  # --- Шаг 1: Docker (идемпотентно) ---
  config.vm.provision "shell", name: "docker", inline: <<-SHELL
    #!/usr/bin/env bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    if ! command -v docker >/dev/null 2>&1; then
      apt-get update
      apt-get install -y docker.io docker-buildx curl
    else
      echo "Docker уже установлен, пропускаем"
    fi

    # Docker без sudo - только для пользователя vagrant
    usermod -aG docker vagrant

    # HTTP-доступ к учебному реестру. Файл переписываем и перезапускаем
    # Docker только если содержимое изменилось
    mkdir -p /etc/docker
    echo '{ "insecure-registries": ["#{VM_IP}:5000"] }' > /tmp/daemon.json
    if ! cmp -s /tmp/daemon.json /etc/docker/daemon.json; then
      install -m 0644 /tmp/daemon.json /etc/docker/daemon.json
      systemctl restart docker
    fi
    systemctl enable --now docker
  SHELL

  # --- Шаг 2: реестр образов (идемпотентно) ---
  config.vm.provision "shell", name: "registry", inline: <<-SHELL
    #!/usr/bin/env bash
    set -euo pipefail

    if ! docker inspect registry >/dev/null 2>&1; then
      echo "Создаём контейнер registry"
      docker run -d --name registry --restart=always -p 5000:5000 -v registry-data:/var/lib/registry registry:3
    else
      echo "Контейнер registry уже существует, запускаем если остановлен"
      docker start registry >/dev/null 2>&1 || true
    fi

    # Ждём, пока API реестра начнёт отвечать
    for i in $(seq 1 30); do
      if curl -sf http://localhost:5000/v2/_catalog >/dev/null 2>&1; then
        break
      fi
      sleep 1
    done
    docker ps --filter name=registry
  SHELL

  # --- Шаг 3: Trivy фиксированной версии с проверкой контрольной суммы ---
  config.vm.provision "shell", name: "trivy", inline: <<-SHELL
    #!/usr/bin/env bash
    set -euo pipefail

    INSTALLED="$(trivy --version 2>/dev/null || true)"
    if [[ "$INSTALLED" == *"Version: #{TRIVY_VERSION}"* ]]; then
      echo "Trivy #{TRIVY_VERSION} уже установлен, пропускаем"
    else
      WORK="$(mktemp -d)"
      cd "$WORK"
      BASE="https://github.com/aquasecurity/trivy/releases/download/v#{TRIVY_VERSION}"
      curl -sSfLO "$BASE/trivy_#{TRIVY_VERSION}_Linux-64bit.tar.gz"
      curl -sSfLO "$BASE/trivy_#{TRIVY_VERSION}_checksums.txt"
      sha256sum --ignore-missing -c "trivy_#{TRIVY_VERSION}_checksums.txt"
      tar -xzf "trivy_#{TRIVY_VERSION}_Linux-64bit.tar.gz" trivy
      install -m 0755 trivy /usr/local/bin/trivy
      cd /
      rm -rf "$WORK"
    fi
    trivy --version
  SHELL
end
